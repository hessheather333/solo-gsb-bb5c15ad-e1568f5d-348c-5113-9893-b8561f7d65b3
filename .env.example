# Server-side HMAC key used to derive reproducible Laplace noise.
# Generate with: openssl rand -hex 32
# Leave empty to auto-generate a key persisted inside the data volume.
DP_SERVER_KEY=

# Admin token for managing API keys (POST/DELETE /auth/keys), passed as the
# X-API-Key header. Generate with: openssl rand -hex 32
# Leave empty to auto-generate one persisted at /data/admin.key (mode 0600).
DP_ADMIN_API_KEY=

# Default total epsilon budget granted to every dataset.
DP_TOTAL_BUDGET=1.0

# Optional per-dataset total budgets (comma-separated id:amount pairs).
# DP_DATASET_BUDGETS=sales:0.5,users:2.0

# SQLite database file (inside the container it lives on the mounted volume).
DATABASE_PATH=/data/dp.db

APP_HOST=0.0.0.0
APP_PORT=8000
